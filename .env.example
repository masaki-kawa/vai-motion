# --- Contact form → Slack notification ---
# Create an Incoming Webhook (https://api.slack.com/messaging/webhooks), pick the channel,
# and paste the URL here. Without it, submissions are accepted and logged but not delivered.
SLACK_WEBHOOK_URL=

# --- Public site origin (OG image + canonical/alternate URLs in metadata) ---
# Set to the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://vaimotion.com
