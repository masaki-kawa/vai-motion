# --- Contact form → Slack notification ---
# Create an Incoming Webhook (https://api.slack.com/messaging/webhooks), pick the channel,
# and paste the URL here. Without it, development accepts and logs the enquiry; production returns
# an error (503) so the form shows its "not sent" message instead of a thank-you.
SLACK_WEBHOOK_URL=

# --- Public site origin (OG image + canonical/alternate URLs in metadata) ---
# Set to the real production domain before launch.
NEXT_PUBLIC_SITE_URL=https://vai-motion.vercel.app
